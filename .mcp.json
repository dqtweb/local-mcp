{
  "mcpServers": {
    "local-agent": {
      "type": "stdio",
      "command": "node",
      "args": [
        "dist/index.js",
        "stdio"
      ],
      "cwd": ".",
      "env": {
        "MCP_DATA_DIR": "data",
        "MCP_WORKSPACE_DIR": "workspace",
        "MCP_BROWSER_MODE": "connect",
        "MCP_BROWSER_CDP_URL": "http://127.0.0.1:9222",
        "MCP_BROWSER_HEADLESS": "false"
      },
      "tools": ["*"]
    }
  }
}
