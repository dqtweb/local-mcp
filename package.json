{
  "name": "mcp-local-server",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mcp-local-server": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts http",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@lancedb/lancedb": "^0.15.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@napi-rs/canvas": "^1.0.9",
    "apache-arrow": "^17.0.0",
    "express": "^5.1.0",
    "playwright": "^1.63.0",
    "ws": "^8.21.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  }
}
